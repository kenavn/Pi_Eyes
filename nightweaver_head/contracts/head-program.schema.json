{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Contracts",
  "type": "object",
  "properties": {
    "event": {
      "$ref": "#/$defs/Event"
    },
    "manifest": {
      "$ref": "#/$defs/Manifest"
    }
  },
  "additionalProperties": false,
  "required": [
    "manifest",
    "event"
  ],
  "$defs": {
    "AudioEncoding": {
      "type": "string",
      "enum": [
        "pcm_s16_le",
        "float32_le"
      ]
    },
    "BundleAudioFacts": {
      "type": "object",
      "properties": {
        "channels": {
          "type": "integer",
          "format": "uint8",
          "maximum": 2,
          "minimum": 1
        },
        "encoding": {
          "$ref": "#/$defs/AudioEncoding"
        },
        "frames": {
          "$ref": "#/$defs/PositiveCounter"
        },
        "sample_rate": {
          "type": "integer",
          "format": "uint32",
          "maximum": 192000,
          "minimum": 8000
        }
      },
      "additionalProperties": false,
      "required": [
        "encoding",
        "frames",
        "sample_rate",
        "channels"
      ]
    },
    "ContentIdentity": {
      "type": "object",
      "properties": {
        "length": {
          "$ref": "#/$defs/PositiveCounter"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false,
      "required": [
        "sha256",
        "length"
      ]
    },
    "Counter": {
      "type": "string",
      "maxLength": 19,
      "pattern": "^([1-9][0-9]{0,17}|9223372036854775807|0|[1-8][0-9]{18}|9[0-1][0-9]{17}|92[0-1][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-6][0-9]{0})$"
    },
    "Event": {
      "type": "object",
      "properties": {
        "at": {
          "$ref": "#/$defs/Time"
        },
        "event": {
          "$ref": "#/$defs/EventKind"
        },
        "use_id": {
          "$ref": "#/$defs/Counter"
        }
      },
      "additionalProperties": false,
      "required": [
        "at",
        "use_id",
        "event"
      ]
    },
    "EventKind": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "begin"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "end"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "both_closed": {
              "type": "boolean"
            },
            "kind": {
              "type": "string",
              "const": "eye"
            },
            "left_closed": {
              "type": "boolean"
            },
            "right_closed": {
              "type": "boolean"
            },
            "source_index": {
              "$ref": "#/$defs/Counter"
            },
            "x": {
              "type": "number",
              "format": "double",
              "maximum": 1,
              "minimum": 0
            },
            "y": {
              "type": "number",
              "format": "double",
              "maximum": 1,
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "source_index",
            "x",
            "y",
            "left_closed",
            "right_closed",
            "both_closed"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "mouth"
            },
            "position": {
              "type": "integer",
              "format": "uint8",
              "maximum": 255,
              "minimum": 0
            },
            "source_index": {
              "$ref": "#/$defs/Counter"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "source_index",
            "position"
          ]
        }
      ]
    },
    "Format": {
      "type": "string",
      "enum": [
        "nightweaver_head_program_1"
      ]
    },
    "ManagedContent": {
      "type": "object",
      "properties": {
        "asset_id": {
          "$ref": "#/$defs/NonNilUuid"
        },
        "identity": {
          "$ref": "#/$defs/ContentIdentity"
        },
        "version_id": {
          "$ref": "#/$defs/NonNilUuid"
        }
      },
      "additionalProperties": false,
      "required": [
        "asset_id",
        "version_id",
        "identity"
      ]
    },
    "Manifest": {
      "type": "object",
      "properties": {
        "audio": {
          "anyOf": [
            {
              "$ref": "#/$defs/BundleAudioFacts"
            },
            {
              "type": "null"
            }
          ]
        },
        "duration_us": {
          "$ref": "#/$defs/PositiveCounter"
        },
        "event_count": {
          "$ref": "#/$defs/PositiveCounter"
        },
        "format": {
          "$ref": "#/$defs/Format"
        },
        "uses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProgramUse"
          },
          "maxItems": 1024,
          "minItems": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "format",
        "duration_us",
        "audio",
        "uses",
        "event_count"
      ]
    },
    "NonNilUuid": {
      "type": "string",
      "format": "uuid",
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      }
    },
    "Occurrence": {
      "type": "object",
      "properties": {
        "path": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/OccurrenceStep"
          },
          "maxItems": 32
        },
        "use_id": {
          "$ref": "#/$defs/NonNilUuid"
        }
      },
      "additionalProperties": false,
      "required": [
        "use_id",
        "path"
      ]
    },
    "OccurrenceStep": {
      "type": "object",
      "properties": {
        "clip_id": {
          "$ref": "#/$defs/NonNilUuid"
        },
        "repeat_index": {
          "$ref": "#/$defs/Counter"
        }
      },
      "additionalProperties": false,
      "required": [
        "clip_id",
        "repeat_index"
      ]
    },
    "PositiveCounter": {
      "type": "string",
      "maxLength": 19,
      "pattern": "^([1-9][0-9]{0,17}|9223372036854775807|[1-8][0-9]{18}|9[0-1][0-9]{17}|92[0-1][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-6][0-9]{0})$"
    },
    "ProgramUse": {
      "type": "object",
      "properties": {
        "audio_start_frame": {
          "$ref": "#/$defs/Counter"
        },
        "end": {
          "$ref": "#/$defs/Time"
        },
        "id": {
          "description": "Contiguous zero-based index in this immutable manifest.",
          "$ref": "#/$defs/Counter"
        },
        "native_audio_frames": {
          "$ref": "#/$defs/Counter"
        },
        "occurrence": {
          "$ref": "#/$defs/Occurrence"
        },
        "resume_auto": {
          "type": "boolean"
        },
        "role_id": {
          "$ref": "#/$defs/NonNilUuid"
        },
        "source_audio": {
          "anyOf": [
            {
              "$ref": "#/$defs/BundleAudioFacts"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_content": {
          "description": "Immutable original archive and decoded facts, distinct from generated PCM.",
          "$ref": "#/$defs/ManagedContent"
        },
        "source_movement_extent_us": {
          "$ref": "#/$defs/Counter"
        },
        "start": {
          "$ref": "#/$defs/Time"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "role_id",
        "occurrence",
        "start",
        "end",
        "resume_auto",
        "source_content",
        "source_audio",
        "audio_start_frame",
        "native_audio_frames",
        "source_movement_extent_us"
      ]
    },
    "Time": {
      "type": "object",
      "properties": {
        "denominator": {
          "$ref": "#/$defs/PositiveCounter"
        },
        "numerator": {
          "$ref": "#/$defs/Counter"
        },
        "whole_us": {
          "$ref": "#/$defs/Counter"
        }
      },
      "additionalProperties": false,
      "required": [
        "whole_us",
        "numerator",
        "denominator"
      ]
    }
  }
}
