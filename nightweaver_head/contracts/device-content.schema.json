{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Contracts",
  "type": "object",
  "properties": {
    "entry": {
      "$ref": "#/$defs/ContentEntry"
    },
    "error": {
      "$ref": "#/$defs/ErrorResponse"
    },
    "inventory": {
      "$ref": "#/$defs/Inventory"
    },
    "query": {
      "$ref": "#/$defs/ContentQuery"
    },
    "receipt": {
      "$ref": "#/$defs/TransferReceiptFields"
    },
    "transfer": {
      "$ref": "#/$defs/TransferRequest"
    },
    "transfer_query": {
      "$ref": "#/$defs/TransferQuery"
    }
  },
  "additionalProperties": false,
  "required": [
    "transfer",
    "receipt",
    "query",
    "transfer_query",
    "entry",
    "inventory",
    "error"
  ],
  "$defs": {
    "ContentEntry": {
      "type": "object",
      "properties": {
        "identity": {
          "$ref": "#/$defs/ContentIdentity"
        },
        "origin": {
          "$ref": "#/$defs/ContentOrigin"
        },
        "pinned": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "identity",
        "origin",
        "pinned"
      ]
    },
    "ContentIdentity": {
      "type": "object",
      "properties": {
        "length": {
          "$ref": "#/$defs/PositiveCounter"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false,
      "required": [
        "sha256",
        "length"
      ]
    },
    "ContentOrigin": {
      "type": "string",
      "enum": [
        "delivered",
        "local_library"
      ]
    },
    "ContentQuery": {
      "type": "object",
      "properties": {
        "device_boot_id": {
          "$ref": "#/$defs/NonNilUuid"
        },
        "identity": {
          "$ref": "#/$defs/ContentIdentity"
        }
      },
      "additionalProperties": false,
      "required": [
        "device_boot_id",
        "identity"
      ]
    },
    "ContentRef": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "asset_id": {
              "$ref": "#/$defs/NonNilUuid"
            },
            "identity": {
              "$ref": "#/$defs/ContentIdentity"
            },
            "kind": {
              "type": "string",
              "const": "managed"
            },
            "version_id": {
              "$ref": "#/$defs/NonNilUuid"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "asset_id",
            "version_id",
            "identity"
          ]
        },
        {
          "description": "Generated preparation bytes have no catalogue asset/version identity.",
          "type": "object",
          "properties": {
            "device_id": {
              "$ref": "#/$defs/NonNilUuid"
            },
            "identity": {
              "$ref": "#/$defs/ContentIdentity"
            },
            "kind": {
              "type": "string",
              "const": "prepared_program"
            },
            "preparation_id": {
              "$ref": "#/$defs/NonNilUuid"
            },
            "ready_set_revision": {
              "$ref": "#/$defs/PositiveCounter"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "preparation_id",
            "ready_set_revision",
            "device_id",
            "identity"
          ]
        }
      ]
    },
    "Counter": {
      "type": "string",
      "maxLength": 19,
      "pattern": "^([1-9][0-9]{0,17}|9223372036854775807|0|[1-8][0-9]{18}|9[0-1][0-9]{17}|92[0-1][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-6][0-9]{0})$"
    },
    "ErrorResponse": {
      "type": "object",
      "properties": {
        "reason": {
          "$ref": "#/$defs/Failure"
        }
      },
      "additionalProperties": false,
      "required": [
        "reason"
      ]
    },
    "Failure": {
      "type": "string",
      "enum": [
        "unauthenticated",
        "malformed",
        "stale_boot",
        "capacity",
        "identity_conflict",
        "content_missing",
        "content_mismatch",
        "length_exceeded",
        "disk_full",
        "transfer_expired",
        "cancelled",
        "outcome_unavailable",
        "shutting_down"
      ]
    },
    "Inventory": {
      "type": "object",
      "properties": {
        "device_boot_id": {
          "$ref": "#/$defs/NonNilUuid"
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ContentEntry"
          },
          "maxItems": 1024
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "device_boot_id",
        "entries",
        "truncated"
      ]
    },
    "NonNilUuid": {
      "type": "string",
      "format": "uuid",
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      }
    },
    "PositiveCounter": {
      "type": "string",
      "maxLength": 19,
      "pattern": "^([1-9][0-9]{0,17}|9223372036854775807|[1-8][0-9]{18}|9[0-1][0-9]{17}|92[0-1][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-6][0-9]{0})$"
    },
    "TransferPhase": {
      "type": "string",
      "enum": [
        "receiving",
        "published",
        "failed"
      ]
    },
    "TransferQuery": {
      "type": "object",
      "properties": {
        "device_boot_id": {
          "$ref": "#/$defs/NonNilUuid"
        },
        "job_id": {
          "$ref": "#/$defs/NonNilUuid"
        }
      },
      "additionalProperties": false,
      "required": [
        "device_boot_id",
        "job_id"
      ]
    },
    "TransferReceiptFields": {
      "type": "object",
      "properties": {
        "failure": {
          "anyOf": [
            {
              "$ref": "#/$defs/Failure"
            },
            {
              "type": "null"
            }
          ]
        },
        "phase": {
          "$ref": "#/$defs/TransferPhase"
        },
        "received_bytes": {
          "$ref": "#/$defs/Counter"
        },
        "request": {
          "$ref": "#/$defs/TransferRequest"
        }
      },
      "additionalProperties": false,
      "required": [
        "request",
        "phase",
        "received_bytes",
        "failure"
      ]
    },
    "TransferRequest": {
      "type": "object",
      "properties": {
        "content": {
          "$ref": "#/$defs/ContentRef"
        },
        "device_boot_id": {
          "$ref": "#/$defs/NonNilUuid"
        },
        "job_id": {
          "$ref": "#/$defs/NonNilUuid"
        }
      },
      "additionalProperties": false,
      "required": [
        "device_boot_id",
        "job_id",
        "content"
      ]
    }
  }
}
